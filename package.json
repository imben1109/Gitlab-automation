{
  "name": "gitlab-automation",
  "version": "1.0.0",
  "description": "Automate GitLab issue workflow with GitHub Copilot AI planning",
  "main": "dist/workflow.js",
  "types": "dist/workflow.d.ts",
  "bin": {
    "gitlab-auto":       "./dist/cli.js",
    "gitlab-automation": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build":      "tsc",
    "prepare":    "tsc",
    "start":      "node dist/cli.js",
    "test":       "jest --coverage",
    "test:shell": "bats tests/bash/gitlab-automation.bats",
    "test:ps":    "pwsh -NoProfile -Command \"Invoke-Pester -Path tests/powershell/gitlab-automation.Tests.ps1 -Output Detailed\"",
    "test:all":   "npm test && npm run test:shell && npm run test:ps"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }],
      "^.+\\.m?js$": "babel-jest"
    },
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "dependencies": {
    "axios":      "^1.6.0",
    "chalk":      "^4.1.2",
    "dotenv":     "^16.3.1",
    "inquirer":   "^8.2.6",
    "simple-git": "^3.20.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node":     "^25.6.0",
    "jest":            "^30.3.0",
    "ts-jest":         "^29.4.9",
    "ts-node":         "^10.9.2",
    "typescript":      "^6.0.3"
  }
}
